# Postgres (local dev default; Railway URL for deploy)
DATABASE_URL=postgresql://localhost:5432/telogify_dev

# LLM provider for the insight agent (openai | anthropic). Switch in .env, no code change.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Only required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Resend (required for send-digest; uses shared sender pre-domain-verification)
RESEND_API_KEY=
RESEND_FROM=Telogify <onboarding@resend.dev>

# FastF1 on-disk cache directory
FASTF1_CACHE=.fastf1_cache

# Base URL the email CTA links back to
WEB_BASE_URL=http://localhost:5173

# Set to "production" on Railway. Gates the startup guard below; NOT derived from WEB_BASE_URL,
# which is the real telogify.com URL even in local dev so Gmail can fetch the digest's images.
ENVIRONMENT=development

# HMAC key for unsubscribe tokens and IP hashing. Required when ENVIRONMENT=production.
# Rotating it invalidates every outstanding unsubscribe link. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SUBSCRIBER_TOKEN_SECRET=

# reCAPTCHA v3 secret. Required when ENVIRONMENT=production; empty locally skips the check.
# The matching site key goes in the frontend as VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET=

# Preview deployments only. Vercel mints a new hostname per deployment, so previews cannot be
# listed in EXTRA_CORS_ORIGINS ahead of time (only the per-branch alias is stable). Keep it
# scoped to the project; a bare .*\.vercel\.app would let any Vercel-hosted site call this API.
# Leave empty in production.
#   CORS_ORIGIN_REGEX=https://telogify-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=
