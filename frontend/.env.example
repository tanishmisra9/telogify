# Backend API base URL. Local default is http://localhost:8000.
# In Vercel, set this to the deployed Railway backend URL.
VITE_API_URL=http://localhost:8000

# reCAPTCHA v3 site key for the subscribe form. Leave empty locally: the widget is skipped and
# the backend skips verification to match, so the form still works end to end without it.
VITE_RECAPTCHA_SITE_KEY=
